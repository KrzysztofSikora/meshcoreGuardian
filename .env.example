# BLE address or advertised name of the MeshCore companion used by `pnpm capture` (S-01).
HW_COMPANION=
# Public key prefix of the repeater used for hardware checks.
HW_REPEATER=
# Guest password for the repeater; leave empty for an open guest login.
HW_GUEST_PASSWORD=
# Select the stub/fake transport in dev builds instead of real BLE.
# EXPO_PUBLIC_TRANSPORT=fake
