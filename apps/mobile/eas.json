{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "node": "24.21.0",
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": { "NODE_ENV": "production" }
    },
    "preview": {
      "node": "24.21.0",
      "distribution": "internal",
      "android": { "buildType": "apk" }
    }
  },
  "submit": {
    "production": {
      "android": { "track": "internal", "releaseStatus": "draft" }
    }
  }
}
